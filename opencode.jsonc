{
  "$schema": "https://opencode.ai/config.json",

  // TODO (Mensch, nicht Agent): exakte OpenRouter-Modell-ID eintragen, sobald
  // `opencode providers login -p openrouter` gelaufen ist und
  // `opencode models openrouter | grep -i qwen` das echte Modell zeigt.
  // Platzhalter unten NICHT ungeprueft verwenden.
  "model": "openrouter/qwen/qwen3.6-35b-a3b",

  "instructions": ["AGENTS.md"],

  // Bewusst KEIN "skills" Key: opencodes Skill-Tool scannt **/SKILL.md und
  // laesst das Modell autonom entscheiden, wann es triggert. Unsere
  // skills/*.md folgen einer anderen, bewusst gewaehlten Konvention
  // (flache Themendateien, manuell per `rg` aus AGENTS.md abgerufen nach
  // Triage-Klasse -> Skill-Tabelle) -- siehe skills/README.md und
  // docs/adr/0001-deterministik-first.md. Beides zu mischen waere
  // widerspruechlich (zwei Retrieval-Pfade fuer dieselbe Datei).

  "default_agent": "migrator",

  "agent": {
    "migrator": {
      "description": "Prüfling: migriert ein T-SQL-Objekt (Klasse B/C) 1:1 nach dbt-Exasol, geführt durch AGENTS.md.",
      "mode": "primary",
      "permission": {
        // Harness-Schutz technisch durchgesetzt (nicht nur Konvention +
        // nachtraeglicher git-diff-Check, siehe docs/adr/0001-deterministik-first.md).
        // Reihenfolge relevant: letzte passende Regel gewinnt.
        "edit": {
          "*": "allow",
          "source_references/**": "deny",
          "tools/**": "deny",
          "skills/**": "deny",
          "docs/**": "deny",
          "reports/**": "deny",
          "ledger.jsonl": "allow",
          "AGENTS.md": "deny",
          "CLAUDE.md": "deny",
          "opencode.jsonc": "deny",
          "dbt/**": "allow",
          "memory/rules/**": "allow"
        },
        // Session 9 (docs/session9-multifile-loading.md): "ask" allein
        // blockierte Qwens eigenen Feedback-Loop vollstaendig im
        // nicht-interaktiven `opencode run` -- "ask" kann dort nie
        // beantwortet werden, jeder bash-Aufruf (auch die laut AGENTS.md
        // ausdruecklich erlaubten make gate/make compare) wurde automatisch
        // abgelehnt. Deshalb genau diese zwei lesenden Kommandos freigegeben,
        // alles andere bleibt "ask" (in headless-Laeufen effektiv "deny") --
        // insbesondere der bekannte Bypass-Weg (z.B. "echo x > tools/y",
        // s. "Weiterhin offen" in CLAUDE.md) bleibt gesperrt.
        // Laufzeit-verifiziert (docs/session9-multifile-loading.md): bei
        // Pipes (z.B. "make gate MONAT=... | tail -10") prueft opencode
        // offenbar jeden Teilbefehl einzeln -- "make gate MONAT=*" allein
        // liess den Aufruf trotzdem an "*": "ask" scheitern, weil "tail -10"
        // nicht erlaubt war. Deshalb zusaetzlich die ueblichen lesenden
        // Anzeige-Befehle freigegeben (kein neues Risiko: Lesezugriff ist
        // fuer Qwen ueber das read-Tool ohnehin schon uneingeschraenkt).
        "bash": {
          "*": "ask",
          "make gate MONAT=*": "allow",
          "make compare MONAT=*": "allow",
          "tail *": "allow",
          "head *": "allow",
          "cat *": "allow",
          "grep *": "allow",
          "wc *": "allow",
          "ls *": "allow",
          "find *": "allow"
        }
      }
    }
  }
}
